# Optional settings for Possum Studio. Copy the lines you need and set them in your shell.
# The app does not read this file automatically. Never commit real values.

# Telegram bot token from @BotFather. Alternative: npm run set-token (saves to data/.token).
TELEGRAM_BOT_TOKEN=

# Data folder (state, settings, videos). Default: data/
POSSUM_DATA_DIR=

# Paths to ffmpeg and ffprobe, if they are not on PATH.
FFMPEG=
FFPROBE=

# Time zone offset in hours, for example 7. Default: system time zone.
POSSUM_TZ=

# Caption font file (TTF). Default: bundled font in assets/fonts.
POSSUM_FONT=

# Local CLIP model file for recognising the pet (optional).
POSSUM_CLIP_MODEL=

# Stats endpoint (not connected by default).
POSSUM_STATS_API=
