{
  "name": "possum-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Possum Studio: Telegram bot and desktop app that edit pet videos into short vertical clips with captions (interface in Russian)",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "set-token": "node scripts/set-token.mjs",
    "app": "electron .",
    "dist": "node scripts/make-icon.mjs && node scripts/fetch-model.mjs && electron-builder --win nsis",
    "demo": "node scripts/demo.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "productName": "Поссум Студия",
  "author": "Possum Studio",
  "main": "app/main.js",
  "build": {
    "appId": "studio.possum.app",
    "productName": "Поссум Студия",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "core/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Поссум Студия",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Поссум Студия",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Possum-Studio-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*.onnx"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  }
}
