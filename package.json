{
  "name": "possum-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сахарный поссум: бот владельца и приложение напарницы — монтаж, совет, выкладка по кнопке",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "set-token": "node scripts/set-token.mjs",
    "app": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "productName": "Поссум-студия",
  "author": "Possum Studio",
  "main": "app/main.js",
  "build": {
    "appId": "studio.possum.app",
    "productName": "Поссум-студия",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "core/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Поссум-студия",
      "artifactName": "Possum-Studio-Setup-${version}.${ext}"
    }
  }
}
